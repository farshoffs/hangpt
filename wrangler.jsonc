{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hangpt",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-05",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application"
  },
  "kv_namespaces": [
    { "binding": "DATA" }
  ],
  "observability": { "enabled": true }
}
